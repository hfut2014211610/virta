{
  "id": "quality",
  "title": "制造质量 · 3 号线不良率异常",
  "story": "9 月 3 号线不良率超出控制上限；Pareto 显示焊点虚焊占 46%；鱼骨定位到夜班新员工与回流焊温区漂移。",
  "charts": [
    {
      "id": "pareto",
      "file": "defects.csv",
      "question": "缺陷集中在哪几类？",
      "spec": {
        "version": 1,
        "view": "bar",
        "variant": "pareto"
      },
      "expectTop": "bar",
      "expectInsight": "concentration"
    },
    {
      "id": "fish",
      "file": "fishbone.csv",
      "question": "根因在哪一环？",
      "spec": {
        "version": 1,
        "view": "fishbone"
      },
      "expectTop": "fishbone"
    },
    {
      "id": "control",
      "file": "daily_defect_rate.csv",
      "question": "不良率何时失控？",
      "spec": {
        "version": 1,
        "view": "control"
      },
      "expectTop": "control",
      "expectInsight": "outlier"
    },
    {
      "id": "shift",
      "file": "line_shift_heat.csv",
      "question": "夜班是否更高发？",
      "spec": {
        "version": 1,
        "view": "heatmap"
      },
      "expectTop": "heatmap"
    },
    {
      "id": "times",
      "file": "process_times.csv",
      "question": "哪道工序离散大？",
      "spec": {
        "version": 1,
        "view": "boxplot"
      },
      "expectTop": "boxplot"
    },
    {
      "id": "yield",
      "file": "yield_kpi.csv",
      "question": "各线良率达标吗？",
      "spec": {
        "version": 1,
        "view": "bullet",
        "mapping": {
          "actual": "实际良率",
          "target": "目标"
        }
      },
      "expectTop": "bullet"
    },
    {
      "id": "output",
      "file": "line_month_output.csv",
      "question": "各线月度产出？",
      "spec": {
        "version": 1,
        "view": "matrix3d"
      },
      "expectTop": "rank"
    },
    {
      "id": "sensor",
      "file": "sensor_batches.csv",
      "question": "工艺参数与不良的关系？",
      "spec": {
        "version": 1,
        "view": "parallel"
      },
      "expectTop": "parallel",
      "expectInsight": "concentration"
    }
  ]
}
